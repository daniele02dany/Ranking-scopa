rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSeasonAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function memberPlayerId() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.playerId;
    }
    function isEnabledMember() {
      return isMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.enabled == true
        && memberPlayerId() is string
        && memberPlayerId().matches('^[a-z0-9-]{2,40}$')
        && exists(/databases/$(database)/documents/players/$(memberPlayerId()));
    }
    function memberPlayerName() {
      return get(/databases/$(database)/documents/players/$(memberPlayerId())).data.name;
    }
    function canUseApp() { return isSeasonAdmin() || isEnabledMember(); }
    function validActor(name) {
      return isEnabledMember() ? name == memberPlayerName() : isSeasonAdmin();
    }
    function canEditProfile(playerId) {
      return isSeasonAdmin() || (isEnabledMember() && memberPlayerId() == playerId);
    }

    match /members/{uid} {
      function validMember() {
        let d = request.resource.data;
        return d.keys().hasAll(['enabled','playerId','createdAt','createdByUid','updatedAt','updatedByUid'])
          && d.keys().hasOnly(['enabled','playerId','createdAt','createdByUid','updatedAt','updatedByUid'])
          && d.enabled is bool && d.playerId is string && d.playerId.matches('^[a-z0-9-]{2,40}$')
          && exists(/databases/$(database)/documents/players/$(d.playerId))
          && d.createdAt is timestamp && d.createdByUid is string
          && d.updatedAt == request.time && d.updatedByUid == request.auth.uid;
      }
      allow get: if signedIn() && (uid == request.auth.uid || isSeasonAdmin());
      allow list: if isSeasonAdmin();
      allow create: if isSeasonAdmin() && validMember()
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isSeasonAdmin() && validMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled','updatedAt','updatedByUid']);
      allow delete: if isSeasonAdmin();
    }
    match /accessRequests/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || isSeasonAdmin());
      allow list: if isSeasonAdmin();
      allow create: if signedIn() && uid == request.auth.uid && !isMember() && !isSeasonAdmin()
        && request.resource.data.keys().hasAll(['uid','requestedName','createdAt'])
        && request.resource.data.keys().hasOnly(['uid','requestedName','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.requestedName is string
        && request.resource.data.requestedName == request.resource.data.requestedName.trim()
        && request.resource.data.requestedName.size() >= 1 && request.resource.data.requestedName.size() <= 50
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isSeasonAdmin();
    }

    function validSeasonId(id) {
      return id is string && id.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }
    // Europe/Rome at the FIRST day of a month: April-October UTC+2, else UTC+1.
    // No browser clock is trusted; all permissions use request.time.
    function monthStart(year, month) {
      return timestamp.date(year, month, 1)
        - duration.value(month >= 4 && month <= 10 ? 2 : 1, 'h');
    }
    function seasonStart(id) {
      return monthStart(int(id.split('-')[0]), int(id.split('-')[1]));
    }
    function seasonEnd(id) {
      let year = int(id.split('-')[0]);
      let month = int(id.split('-')[1]);
      return monthStart(month == 12 ? year + 1 : year, month == 12 ? 1 : month + 1);
    }
    function openCurrentSeason(id) {
      return validSeasonId(id) && request.time >= seasonStart(id) && request.time < seasonEnd(id)
        && (!exists(/databases/$(database)/documents/seasons/$(id))
          || get(/databases/$(database)/documents/seasons/$(id)).data.get('closed', false) != true);
    }
    function validName(value) { return value is string && value.trim().size() > 0 && value.size() <= 200; }

    // Stop at the actual list length. Evaluating 32 helper calls for each
    // of three lists exceeded the 1000-expression Rules budget even for a small podium.
    // Fixed-size blocks keep expression nesting and function depth bounded.
    function validAwardsFrom0(items) {
      return (items.size() <= 0 || (validName(items[0]) && (items.size() <= 1 || (validName(items[1]) && (items.size() <= 2 || (validName(items[2]) && (items.size() <= 3 || (validName(items[3]) && validAwardsFrom4(items)))))))));
    }
    function validAwardsFrom4(items) {
      return (items.size() <= 4 || (validName(items[4]) && (items.size() <= 5 || (validName(items[5]) && (items.size() <= 6 || (validName(items[6]) && (items.size() <= 7 || (validName(items[7]) && validAwardsFrom8(items)))))))));
    }
    function validAwardsFrom8(items) {
      return (items.size() <= 8 || (validName(items[8]) && (items.size() <= 9 || (validName(items[9]) && (items.size() <= 10 || (validName(items[10]) && (items.size() <= 11 || (validName(items[11]) && validAwardsFrom12(items)))))))));
    }
    function validAwardsFrom12(items) {
      return (items.size() <= 12 || (validName(items[12]) && (items.size() <= 13 || (validName(items[13]) && (items.size() <= 14 || (validName(items[14]) && (items.size() <= 15 || (validName(items[15]) && validAwardsFrom16(items)))))))));
    }
    function validAwardsFrom16(items) {
      return (items.size() <= 16 || (validName(items[16]) && (items.size() <= 17 || (validName(items[17]) && (items.size() <= 18 || (validName(items[18]) && (items.size() <= 19 || (validName(items[19]) && validAwardsFrom20(items)))))))));
    }
    function validAwardsFrom20(items) {
      return (items.size() <= 20 || (validName(items[20]) && (items.size() <= 21 || (validName(items[21]) && (items.size() <= 22 || (validName(items[22]) && (items.size() <= 23 || (validName(items[23]) && validAwardsFrom24(items)))))))));
    }
    function validAwardsFrom24(items) {
      return (items.size() <= 24 || (validName(items[24]) && (items.size() <= 25 || (validName(items[25]) && (items.size() <= 26 || (validName(items[26]) && (items.size() <= 27 || (validName(items[27]) && validAwardsFrom28(items)))))))));
    }
    function validAwardsFrom28(items) {
      return (items.size() <= 28 || (validName(items[28]) && (items.size() <= 29 || (validName(items[29]) && (items.size() <= 30 || (validName(items[30]) && (items.size() <= 31 || (validName(items[31]) && true))))))));
    }
    function validAwards(items) {
      return items is list && items.size() <= 32 && items.toSet().size() == items.size()
        && validAwardsFrom0(items);
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Members authorize photos. ownerUid is optional legacy metadata, never an authority.
    match /playerProfiles/{playerId} {
      function validAvatar() {
        let d = request.resource.data;
        return playerId.matches('^[a-z0-9-]{2,40}$')
          && exists(/databases/$(database)/documents/players/$(playerId))
          && d.keys().hasAll(['avatarData','avatarUpdatedAt','avatarUpdatedByUid'])
          && d.keys().hasOnly(['avatarData','avatarUpdatedAt','avatarUpdatedByUid','ownerUid'])
          && (!d.keys().hasAny(['ownerUid']) || (d.ownerUid is string && d.ownerUid.size() > 0))
          && d.avatarData is string && d.avatarData.size() <= 153600
          && (d.avatarData == '' || d.avatarData.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/]+={0,2}$'))
          && d.avatarUpdatedAt == request.time && d.avatarUpdatedByUid == request.auth.uid;
      }
      allow read: if canUseApp();
      allow create: if canEditProfile(playerId) && validAvatar()
        && !request.resource.data.keys().hasAny(['ownerUid']);
      allow update: if canEditProfile(playerId) && validAvatar()
        && request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null);
      allow delete: if isSeasonAdmin();
    }

    match /players/{playerId} {
      function stablePlayerSchema(data) {
        return playerId.matches('^[a-z0-9-]{2,40}$')
          && data.keys().hasAll(['name','active','createdAt','createdByUid','updatedAt','updatedByUid'])
          && data.keys().hasOnly(['name','active','createdAt','createdByUid','updatedAt','updatedByUid'])
          && data.name is string && data.name.trim().size() > 0 && data.name.size() <= 50
          && data.active is bool
          && data.createdAt is timestamp && data.updatedAt is timestamp
          && data.createdByUid is string && data.updatedByUid is string;
      }
      allow read: if canUseApp();
      allow create: if isSeasonAdmin() && stablePlayerSchema(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid;
      allow update: if isSeasonAdmin()
        && stablePlayerSchema(resource.data) && stablePlayerSchema(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt','updatedByUid'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }

    match /matches/{matchId} {
      function validNewMatch() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'seasonId', 'teamA', 'teamB', 'excluded',
            'createdByPlayer', 'createdByUid', 'createdAt', 'status'
          ])
          && openCurrentSeason(data.seasonId)
          && data.teamA is list && data.teamA.size() == 2
          && validName(data.teamA[0]) && validName(data.teamA[1])
          && data.teamB is list && data.teamB.size() == 2
          && validName(data.teamB[0]) && validName(data.teamB[1])
          && data.excluded is list
          && data.teamA.concat(data.teamB).concat(data.excluded).toSet().size() == 4 + data.excluded.size()
          && validName(data.createdByPlayer) && validActor(data.createdByPlayer)
          && data.createdByUid == request.auth.uid
          && data.createdAt == request.time
          && data.status == 'in_progress';
      }
      function validMatchNapoleon() {
        let data = request.resource.data;
        return data.napoleon is list && data.napoleon.size() <= 4
          && data.napoleon.toSet().size() == data.napoleon.size()
          && data.teamA.concat(data.teamB).hasAll(data.napoleon);
      }
      function validScore() {
        let data = request.resource.data;
        return data.status == 'completed'
          && data.scoreA is int && data.scoreA >= 0 && data.scoreA <= 9007199254740991
          && data.scoreB is int && data.scoreB >= 0 && data.scoreB <= 9007199254740991
          && data.scoreA != data.scoreB
          && data.winnerTeam == (data.scoreA > data.scoreB ? 'A' : 'B');
      }
      function validRevision() {
        return request.resource.data.matchRevision is int
          && request.resource.data.matchRevision == resource.data.get('matchRevision', 0) + 1;
      }
      function validCompletion() {
        let data = request.resource.data;
        return resource.data.status == 'in_progress'
          && data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'scoreA', 'scoreB', 'winnerTeam', 'matchRevision', 'completedAt', 'completedByUid', 'completedByPlayer', 'napoleon'
          ])
          && validScore() && validMatchNapoleon()
          && validName(data.completedByPlayer) && validActor(data.completedByPlayer)
          && data.completedByUid == request.auth.uid && data.completedAt == request.time;
      }
      function validCorrection() {
        let data = request.resource.data;
        let previous = resource.data;
        return previous.status == 'completed'
          && data.diff(previous).affectedKeys().hasOnly([
            'scoreA', 'scoreB', 'winnerTeam', 'matchRevision', 'napoleon',
            'correctionCount', 'previousResult', 'correctedAt', 'correctedByUid'
          ])
          && validScore() && validMatchNapoleon()
          && (data.scoreA != previous.scoreA || data.scoreB != previous.scoreB
            || data.napoleon.toSet() != previous.get('napoleon', []).toSet())
          && data.correctionCount is int
          && data.correctionCount == previous.get('correctionCount', 0) + 1
          && data.previousResult == {
            'scoreA': previous.scoreA, 'scoreB': previous.scoreB, 'winnerTeam': previous.winnerTeam, 'napoleon': previous.get('napoleon', [])
          }
          && data.correctedByUid == request.auth.uid && data.correctedAt == request.time;
      }
      function validCancellation() {
        let data = request.resource.data;
        let resultFields = [
          'scoreA', 'scoreB', 'winnerTeam', 'completedAt', 'completedByUid', 'completedByPlayer', 'napoleon',
          'correctionCount', 'previousResult', 'correctedAt', 'correctedByUid', 'ratingDelta'
        ];
        return resource.data.status == 'completed' && data.status == 'in_progress'
          && data.diff(resource.data).affectedKeys().hasOnly(resultFields.concat(['status', 'matchRevision']))
          && !data.keys().hasAny(resultFields);
      }
      allow read: if canUseApp();
      allow create: if canUseApp() && validNewMatch();
      allow update: if canUseApp() && openCurrentSeason(resource.data.seasonId) && validRevision()
        && (validCompletion() || validCorrection() || validCancellation());
      allow delete: if isSeasonAdmin() && openCurrentSeason(resource.data.seasonId);
    }

    match /seasons/{seasonId} {
      // Rules cannot iterate arbitrary lists. Validate up to 32 entries explicitly;
      // Never truncate tied players; the overall Rules expression budget still applies.
      function validPodiumItem(items, index) {
        let entry = items[index];
        return entry is map
          && entry.keys().hasOnly(['position', 'player'])
          && entry.position is int && entry.position >= 1 && entry.position <= 3
          && validName(entry.player);
      }
      function validPodiumFrom0(items) {
        return (items.size() <= 0 || (validPodiumItem(items, 0) && (items.size() <= 1 || (validPodiumItem(items, 1) && (items.size() <= 2 || (validPodiumItem(items, 2) && (items.size() <= 3 || (validPodiumItem(items, 3) && validPodiumFrom4(items)))))))));
      }
      function validPodiumFrom4(items) {
        return (items.size() <= 4 || (validPodiumItem(items, 4) && (items.size() <= 5 || (validPodiumItem(items, 5) && (items.size() <= 6 || (validPodiumItem(items, 6) && (items.size() <= 7 || (validPodiumItem(items, 7) && validPodiumFrom8(items)))))))));
      }
      function validPodiumFrom8(items) {
        return (items.size() <= 8 || (validPodiumItem(items, 8) && (items.size() <= 9 || (validPodiumItem(items, 9) && (items.size() <= 10 || (validPodiumItem(items, 10) && (items.size() <= 11 || (validPodiumItem(items, 11) && validPodiumFrom12(items)))))))));
      }
      function validPodiumFrom12(items) {
        return (items.size() <= 12 || (validPodiumItem(items, 12) && (items.size() <= 13 || (validPodiumItem(items, 13) && (items.size() <= 14 || (validPodiumItem(items, 14) && (items.size() <= 15 || (validPodiumItem(items, 15) && validPodiumFrom16(items)))))))));
      }
      function validPodiumFrom16(items) {
        return (items.size() <= 16 || (validPodiumItem(items, 16) && (items.size() <= 17 || (validPodiumItem(items, 17) && (items.size() <= 18 || (validPodiumItem(items, 18) && (items.size() <= 19 || (validPodiumItem(items, 19) && validPodiumFrom20(items)))))))));
      }
      function validPodiumFrom20(items) {
        return (items.size() <= 20 || (validPodiumItem(items, 20) && (items.size() <= 21 || (validPodiumItem(items, 21) && (items.size() <= 22 || (validPodiumItem(items, 22) && (items.size() <= 23 || (validPodiumItem(items, 23) && validPodiumFrom24(items)))))))));
      }
      function validPodiumFrom24(items) {
        return (items.size() <= 24 || (validPodiumItem(items, 24) && (items.size() <= 25 || (validPodiumItem(items, 25) && (items.size() <= 26 || (validPodiumItem(items, 26) && (items.size() <= 27 || (validPodiumItem(items, 27) && validPodiumFrom28(items)))))))));
      }
      function validPodiumFrom28(items) {
        return (items.size() <= 28 || (validPodiumItem(items, 28) && (items.size() <= 29 || (validPodiumItem(items, 29) && (items.size() <= 30 || (validPodiumItem(items, 30) && (items.size() <= 31 || (validPodiumItem(items, 31) && true))))))));
      }
      function validPodium(items) {
        return items is list && items.size() <= 32
          && (items.size() == 0 || items[0].position == 1)
          && items.toSet().size() == items.size()
          && validPodiumFrom0(items);
      }
      function validClosure() {
        let data = request.resource.data;
        return validSeasonId(seasonId) && request.time >= seasonEnd(seasonId)
          && data.keys().hasAll(['seasonId','year','month','name','closed','closedAt','podium','napoleon','weakRing'])
          && data.seasonId == seasonId
          && data.year is int && data.year == int(seasonId.split('-')[0])
          && data.month is int && data.month == int(seasonId.split('-')[1])
          && data.name is string && data.name.size() <= 200
          && data.closed == true && data.closedAt == request.time
          && validPodium(data.podium) && validAwards(data.napoleon) && validAwards(data.weakRing);
      }
      allow read: if canUseApp();
      allow create: if isSeasonAdmin() && validClosure()
        && request.resource.data.keys().hasOnly(['seasonId','year','month','name','closed','closedAt','podium','napoleon','weakRing'])
        && request.resource.data.name == '';
      // Finalize an open season only: preserve its name. The authorized admin derives awards from matches.
      allow update: if isSeasonAdmin() && resource.data.get('closed', false) == false && validClosure()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'seasonId','year','month','name','closed','closedAt','podium','napoleon','weakRing'
        ])
        && request.resource.data.name == resource.data.get('name', '');
      allow delete: if false;
    }
  }
}
